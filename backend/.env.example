# Copy this file to .env and adjust. .env is git-ignored; .env.example is not.
# Nothing here is a secret: this project has no API keys and no database.

# ---- Identity -------------------------------------------------------------
APP_NAME="AI Resume Analyzer"
# development | production. Only affects logging verbosity and the /api/health
# payload; it does not change any behaviour of the analysis.
ENVIRONMENT=development

# ---- CORS -----------------------------------------------------------------
# Comma-separated list of origins allowed to call this API from a browser.
# An origin is scheme + host + port: http://localhost:5173 and
# http://127.0.0.1:5173 are DIFFERENT origins, so both are listed.
# In production, replace with your Vercel URL, e.g.
#   CORS_ORIGINS=https://resume-signal.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Uploads --------------------------------------------------------------
# Comfortably above any real resume, low enough that a malicious upload cannot
# fill the disk. The API rejects anything larger with a 413.
MAX_UPLOAD_MB=5
ALLOWED_EXTENSIONS=.pdf,.docx
# Uploads land here and are deleted in a finally block after every request.
TEMP_DIR=data/temp

# ---- Data -----------------------------------------------------------------
# Where skill_dictionary.csv and job_roles.csv live.
DATA_DIR=data

# ---- Semantic tier --------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Set to false to run without the embedding model: faster boot, ~400MB less
# memory, slightly less accurate scores. The remaining two tiers are
# renormalised so the score stays on 0-100. The test suite sets this
# automatically; set it here if a host runs out of memory.
ENABLE_SEMANTIC=true
