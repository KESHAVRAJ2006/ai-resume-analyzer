# Copy to .env.local for local dev. Vite only exposes variables prefixed VITE_.
#
# IMPORTANT: Vite inlines this at BUILD time, not at runtime. Changing it means
# rebuilding (npm run build) - setting it on a running container does nothing.
#
# Port 8001, not 8000: this machine already runs another FastAPI app on 8000.
VITE_API_URL=http://127.0.0.1:8001

# In production (Vercel) set this in the project's Environment Variables to
# your Render URL, e.g.
# VITE_API_URL=https://resume-analyzer-api.onrender.com
